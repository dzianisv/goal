        <mxCell id="session2" value="Session 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#111111;fontSize=36;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1000" y="470" width="360" height="90" as="geometry" />
