        <mxCell id="system" value="System message" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#111111;fontSize=36;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="480" y="590" width="640" height="84" as="geometry" />
        </mxCell>
