          <mxGeometry x="480" y="708" width="640" height="84" as="geometry" />
        </mxCell>
        <mxCell id="ai" value="AI message" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#111111;fontSize=36;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="480" y="826" width="640" height="84" as="geometry" />
        </mxCell>
        <mxCell id="toolcall" value="Tool call: goal&lt;br/&gt;{ create, objective,&lt;br/&gt;acceptance_criteria }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#000000;strokeWidth=4;fontColor=#111111;fontSize=36;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="480" y="944" width="640" height="150" as="geometry" />
        </mxCell>
        <mxCell id="tools" value="&lt;span style='font-size:40px'&gt;&lt;b&gt;Tools:&lt;/b&gt;&lt;/span&gt;&lt;br/&gt;goal&lt;br/&gt;read&lt;br/&gt;write" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#111111;fontSize=36;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="600" width="400" height="250" as="geometry" />
        </mxCell>
        <mxCell id="infer" value="&lt;span style='font-size:40px'&gt;&lt;b&gt;★ AUTO-INFERRED — in the main session&lt;/b&gt;&lt;/span&gt;&lt;br/&gt;The agent itself, in the same turn as the user message,&lt;br/&gt;infers the goal and declares it with this call.&lt;br/&gt;No background API call infers the goal." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#000000;strokeWidth=2;fontColor=#111111;fontSize=30;align=left;verticalAlign=middle;spacingLeft=30;" vertex="1" parent="1">
          <mxGeometry x="1200" y="934" width="1080" height="200" as="geometry" />
        </mxCell>
        <mxCell id="judge" value="&lt;span style='font-size:40px'&gt;&lt;b&gt;Judge (auxiliary model) — checks DONE only&lt;/b&gt;&lt;/span&gt;&lt;br/&gt;judge_goal asks only 'is the goal DONE?' — it never infers the goal." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#111111;fontSize=30;align=left;verticalAlign=middle;spacingLeft=30;" vertex="1" parent="1">
          <mxGeometry x="1200" y="816" width="1080" height="104" as="geometry" />
        </mxCell>
        <mxCell id="inject" value="&lt;span style='font-size:40px'&gt;&lt;b&gt;What injects the goal back into the session?&lt;/b&gt;&lt;/span&gt;&lt;br/&gt;1 · Heartbeat tick — next_continuation_prompt feeds the goal back as a user-role message.&lt;br/&gt;2 · Idle-wake — the barrier-wake chore re-pokes an active goal after 15 min idle (idle_wake_seconds = 900).&lt;br/&gt;&lt;b&gt;Both re-assert the EXISTING goal. Never inferred in the background.&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#111111;fontSize=36;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="400" y="1196" width="2000" height="260" as="geometry" />
        </mxCell>
        <mxCell id="note-override" value="&lt;span style='font-size:32px'&gt;&lt;b&gt;Side note — /goal is an override, not the flow&lt;/b&gt;&lt;/span&gt;&lt;br/&gt;Den can set the goal with /goal — a user-set goal always wins,&lt;br/&gt;the agent cannot replace it. That is an override, not the flow." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#111111;fontSize=30;align=left;verticalAlign=top;spacingLeft=30;spacingTop=14;" vertex="1" parent="1">
          <mxGeometry x="60" y="1506" width="1290" height="348" as="geometry" />
        </mxCell>
        <mxCell id="note-watchout" value="&lt;span style='font-size:32px'&gt;&lt;b&gt;WATCH OUT — known bugs in Hermes (do not copy)&lt;/b&gt;&lt;/span&gt;&lt;br/&gt;Goal dies at context compression — flat goal:&lt;session_id&gt; lookup, no parent walk.&lt;br/&gt;Agent goals have no per-turn judge or turn budget — no stall detection.&lt;br/&gt;A dead judge never pauses the goal — it fails open to continue.&lt;br/&gt;The agent grades its own criteria — it writes them, the audit checks them.&lt;br/&gt;Stop-check plugin broken on Linux — symlink to a macOS path, does not load.&lt;br/&gt;Goal tool off by default — the mechanism is silent unless opted in." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#111111;fontSize=30;align=left;verticalAlign=top;spacingLeft=30;spacingTop=14;" vertex="1" parent="1">
          <mxGeometry x="1374" y="1506" width="1290" height="348" as="geometry" />
        </mxCell>
        <mxCell id="dots" value="…" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#666666;fontSize=44" vertex="1" parent="1">
          <mxGeometry x="770" y="1140" width="60" height="48" as="geometry" />
        </mxCell>
        <mxCell id="feedback-label" value="goal fed back in" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#666666;fontSize=30" vertex="1" parent="1">
          <mxGeometry x="1930" y="1162" width="300" height="36" as="geometry" />
        </mxCell>
        <mxCell id="legend1" value="Solid arrow = call / flow  ·  dashed line = the judge, called after a turn and at complete" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#666666;fontSize=26" vertex="1" parent="1">
          <mxGeometry x="400" y="1870" width="2000" height="36" as="geometry" />
