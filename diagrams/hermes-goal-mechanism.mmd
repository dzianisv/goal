%% How the goal works in Hermes — compact, GitHub-readable.
%% Styled to match the PNG: plain white boxes, black borders,
%% green highlight on the auto-inferred goal. The PNG is the
%% full-detail version (same structure, longer notes).
%% Read from the code: /home/engineer/.hermes/hermes-agent/
%% tools/goal_tool.py, hermes_cli/goals.py, agent/prompt_builder.py.
%% Verified 2026-11-15. Detail lives in hermes-goal-mechanism.md.

flowchart TD
    classDef plain fill:#fff,stroke:#000,stroke-width:2px,color:#000
    classDef hl fill:#e8f5e9,stroke:#000,stroke-width:3px,color:#000

    OC("OpenClaw"):::plain
    P1("Profile: agent1"):::plain
    P2("Profile: agent2"):::plain
    S1("Session 1"):::plain
    S2("Session 2"):::plain
    SYS("System message"):::plain
    USR("User message"):::plain
    AI("AI message"):::plain
    CALL("Tool call: goal { create }"):::hl
    TOOLS("Tools: goal · read · write"):::plain
    INFER("★ AUTO-INFERRED — agent declares it in the same turn"):::hl
    JUDGE("Judge — checks DONE only, never infers"):::plain
    INJ("Goal fed back: heartbeat tick + idle re-poke (15 min)"):::plain
    OVER("Den's /goal = override only"):::plain

    OC --> P1
    OC --> P2
    P1 --> S1
    P1 --> S2
    S1 --> SYS
    SYS --> USR
    USR --> AI
    AI --> CALL
    SYS --> TOOLS
    CALL --- INFER
    AI -.- JUDGE
    INJ --> USR
    CALL --> INJ
    CALL -.- OVER
