        <mxCell id="e-step1-sup" value="" style="html=1;endArrow=classic;endFill=1;strokeColor=#000000;strokeWidth=3;fontColor=#666666;fontSize=30;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="step1" target="supervisor">
