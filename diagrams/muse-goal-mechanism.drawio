<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" type="device">
  <diagram id="muse-goal-1" name="Page-1">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2800" pageHeight="1314" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="How the goal works in Muse" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#111111;fontSize=52;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="400" y="30" width="2000" height="70" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="From the design description + Muse's goal docs — NOT from Muse internals · do not read more into it" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#555555;fontSize=30" vertex="1" parent="1">
          <mxGeometry x="400" y="110" width="2000" height="40" as="geometry" />
        </mxCell>
        <mxCell id="step1" value="★ 1 · Muse sets the goal AUTOMATICALLY&lt;br/&gt;infers it from the project / conversation and declares it itself&lt;br/&gt;no set-goal command from Den" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#000000;strokeWidth=4;fontColor=#111111;fontSize=36;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="500" y="170" width="1200" height="150" as="geometry" />
        </mxCell>
        <mxCell id="supervisor" value="Supervisor — hourly&lt;br/&gt;re-asserts that goal each run" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#111111;fontSize=36;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="500" y="354" width="1200" height="140" as="geometry" />
        </mxCell>
        <mxCell id="pick" value="Picks the next highest-priority UNBLOCKED card" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#111111;fontSize=36;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="500" y="528" width="1200" height="96" as="geometry" />
        </mxCell>
        <mxCell id="build" value="Subagent builds the picked card" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#111111;fontSize=36;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="500" y="658" width="1200" height="96" as="geometry" />
        </mxCell>
        <mxCell id="update" value="Subagent updates the board" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#111111;fontSize=36;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="500" y="788" width="1200" height="96" as="geometry" />
        </mxCell>
        <mxCell id="board" value="&lt;span style='font-size:40px'&gt;&lt;b&gt;Board&lt;/b&gt;&lt;/span&gt;&lt;br/&gt;the cards&lt;br/&gt;goal: declared by Muse" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#111111;fontSize=36;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1920" y="394" width="640" height="220" as="geometry" />
        </mxCell>
        <mxCell id="loop-label" value="next hour — supervisor runs again" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#666666;fontSize=30" vertex="1" parent="1">
          <mxGeometry x="250" y="898" width="600" height="36" as="geometry" />
        </mxCell>
        <mxCell id="bottom-note" value="&lt;span style='font-size:32px'&gt;&lt;b&gt;The goal is set automatically — Den never issues a set-goal command&lt;/b&gt;&lt;/span&gt;&lt;br/&gt;Muse infers the goal from the project / conversation and declares it itself.&lt;br/&gt;Den states what he wants in conversation — product owner, not goal-setter.&lt;br/&gt;No idle trigger — hourly schedule." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#111111;fontSize=30;align=left;verticalAlign=top;spacingLeft=30;spacingTop=14;" vertex="1" parent="1">
          <mxGeometry x="400" y="994" width="2000" height="228" as="geometry" />
        </mxCell>
        <mxCell id="legend1" value="Solid arrow = flow  ·  loop on the left = every hour, back to the supervisor" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#666666;fontSize=26" vertex="1" parent="1">
          <mxGeometry x="400" y="1238" width="2000" height="36" as="geometry" />
        </mxCell>
        <mxCell id="legend2" value="Plain boxes, black on white, as in Den's sketch" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#666666;fontSize=26" vertex="1" parent="1">
          <mxGeometry x="400" y="1270" width="2000" height="36" as="geometry" />
